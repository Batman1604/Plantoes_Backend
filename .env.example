# Modelo de configuração do backend. Copie para `.env` e preencha.
# Nunca commite o `.env` real (está no .gitignore).

# ---------------------------------------------------------------------------
# OBRIGATÓRIAS — sem elas o servidor não sobe (AUD-012).
# ---------------------------------------------------------------------------
# Conexão com o Postgres.
DATABASE_URL=postgresql+psycopg://postgres:DeusAbutre@localhost:5432/plantoes?sslmode=require
# Supabase: use a string do "Session pooler" (Connect > Session pooler), que
# funciona em IPv4. A conexão direta (db.<ref>.supabase.co) é só IPv6, e o
# "Transaction pooler" (porta 6543) não aceita os prepared statements que o
# psycopg 3 cria. Troque o prefixo "postgresql://" por "postgresql+psycopg://",
# percent-encode caracteres especiais da senha e exija TLS:
# DATABASE_URL=postgresql+psycopg://postgres.<ref>:<SENHA>@aws-<N>-<regiao>.pooler.supabase.com:5432/postgres?sslmode=require
# Exatamente um de: development | test | production.
# Qualquer outro valor (ex.: "prod", "Production") derruba o import.
ENVIRONMENT=development
# Segredo de assinatura dos JWT. Gere um valor aleatório longo, por ex.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# ---------------------------------------------------------------------------
# OBRIGATÓRIA EM PRODUÇÃO
# ---------------------------------------------------------------------------
# Origens CORS separadas por vírgula. "*" é recusado com ENVIRONMENT=production.
ALLOWED_ORIGINS=*

# ---------------------------------------------------------------------------
# Opcionais
# ---------------------------------------------------------------------------
# JWT_EXPIRE_MINUTES=1440
# LOG_LEVEL=INFO
# Vazio = automático (ativo só em produção). 1/0 força ligado/desligado.
# RATE_LIMIT_ENABLED=
# IPs do proxy reverso dos quais se aceita X-Forwarded-For (vírgula). Vazio =
# usa o IP da conexão. "*" (Render, proxy sem IP fixo) = vale o último item do
# X-Forwarded-For. Ver README, "Limite de requisições".
# TRUSTED_PROXY_IPS=

# Código por e-mail do cadastro e da redefinição de senha pelo Supabase Auth.
# As duas juntas ou nenhuma. Vazias = canal antigo (WhatsApp/SMTP; fora de
# produção, o código aparece no log). Só a chave anon (pública); a
# service_role NUNCA vai aqui. Ver README, "Deploy no Render + Supabase".
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_ANON_KEY=

# E-mail (códigos de redefinição de senha e feedback). Sem SMTP, fora de
# produção o código de redefinição aparece no log do servidor.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_USE_TLS=true
# Destino do feedback enviado pelo app. Sem ele, /feedback responde 503.
# FEEDBACK_EMAIL_TO=

# Login social (aceitam vários valores separados por vírgula).
# GOOGLE_CLIENT_ID=
# APPLE_CLIENT_ID=

# Webhook de upgrade de plano (header X-Upgrade-Secret).
# UPGRADE_WEBHOOK_SECRET=

# WhatsApp (envio de códigos e assistente). Se WHATSAPP_TOKEN for definido,
# WHATSAPP_APP_SECRET e WHATSAPP_VERIFY_TOKEN passam a ser OBRIGATÓRIOS.
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=

# Assistente de IA do WhatsApp.
# ANTHROPIC_API_KEY=
